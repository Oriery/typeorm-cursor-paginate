{
  "name": "typeorm-cursor-paginate",
  "version": "3.0.0",
  "description": "Cursor-based pagination with directional cursors.",
  "keywords": [
    "directional",
    "cursor",
    "pagination",
    "cursor-based",
    "paginator",
    "direction",
    "paginate",
    "typeorm",
    "typescript"
  ],
  "author": "Aleksandr Panev <aleksandr.panev.2002@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oriery/typeorm-cursor-paginate"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "prepack": "npm run build",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:lint && npm run test:format && npm run test:unit",
    "test:lint": "eslint . --max-warnings=0",
    "test:format": "prettier . --check",
    "format": "prettier . --write",
    "test:unit": "jest src --runInBand",
    "test:postgres": "node scripts/test-postgres.cjs",
    "test:package": "node scripts/test-package.cjs",
    "check": "npm test && npm run typecheck && npm run test:postgres && npm run test:package"
  },
  "peerDependencies": {
    "typeorm": "^0.3.21 || ^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.6",
    "typeorm": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "types": "./lib/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.mjs",
    "lib/**/*.d.ts",
    "lib/**/*.d.mts",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "License",
    "docs/core-contract.md"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.11.0 || ^26.0.0"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  }
}
