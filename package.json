{
  "name": "typeorm-cursor-paginate",
  "version": "2.2.0",
  "description": "Cursor-based pagination with directional cursors.",
  "keywords": [
    "directional",
    "cursor",
    "pagination",
    "cursor-based",
    "paginator",
    "direction",
    "paginate",
    "typeorm",
    "typescript"
  ],
  "author": "Aleksandr Panev <aleksandr.panev.2002@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oriery/typeorm-cursor-paginate"
  },
  "main": "lib/src/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "prepack": "npm run test && npm run build",
    "build": "rimraf ./lib && swc src -d lib --config-file ./build.swcrc && tsc",
    "test": "npm run test:lint && npm run test:unit",
    "test:lint": "eslint src/**/**/*.ts",
    "test:unit": "jest src --runInBand"
  },
  "peerDependencies": {
    "typeorm": "^0.3.21 || ^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typeorm": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
